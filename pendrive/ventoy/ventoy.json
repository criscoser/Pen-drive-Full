      "image": "/ISOs/Linux/linuxmint-22.3-xfce-64bit.iso",
      "archive": "/ventoy/diagnostico-linux.tar.gz"
    }
  ],
  "menu_alias": [
    {
      "image": "/ISOs/Linux/linuxmint-22.3-xfce-64bit.iso",
